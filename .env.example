# SST loads this file into process.env when it evaluates sst.config.ts.
# Those variables are not available inside Lambda unless they are listed in
# HONO_ENV_KEYS in sst.config.ts (forwarded via the Function `environment` block).

SLACK_BOT_TOKEN=your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

DISCORD_BOT_TOKEN=your-bot-token
DISCORD_PUBLIC_KEY=your-public-key
DISCORD_APPLICATION_ID=your-application-id
CRON_SECRET=your-cron-secret

REDIS_URL=your-redis-url
